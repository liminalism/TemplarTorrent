    result pass
    method command
    observed_at git:1ba08ab254839e103de22fe72eddfe30d3efdc80
    command "cargo test -p templartorrent-rbit-adapter --lib portmap; OUT=../.agent/scratch/fuzz fuzz/run.sh 60 portmap_parsers; TT_PORTMAP_PROBE=1 cargo test -p templartorrent-rbit-adapter --lib real_gateway_probe -- --ignored --nocapture"

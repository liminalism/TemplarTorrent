akr 0.1
project templartorrent

record templartorrent.evidence.announce-transport/1 : evidence {
    title "Ubuntu 26.04.1, rustc 1.99.0, tree 2b9ca3f plus the rbit fork: 52 adapter tests passed (14 unit, 24 driver, 11 localhost, 3 multiblock). New announce unit tests: the GET keeps a passkey query and percent-encodes binary info hash and peer id, sets Host with a non-default port and Connection: close, and a bare host gets path /; https is refused with \"https trackers need TLS support that this client does not build\"; HTTP parsing accepts 200 with content length (ignoring trailing bytes) and chunked bodies with extensions, refuses 302, 404, truncated bodies, bad chunk sizes, a missing header terminator and a non-HTTP status line; the body parser reads compact IPv4 and IPv6 peers, dictionary peers, intervals and counts, and refuses failure reasons, missing interval, non-bencode and non-dictionary bodies. The loopback HTTP tracker fixtures in the driver, restore and multiblock tests discovered peers end to end through the new transport."
    state verified
    result pass
    method command
    observed_at git:2b9ca3f76e528a0e79186a25e6053e38eb0024cc
    command "cargo test -p templartorrent-rbit-adapter"
    artifact "perf-results/2026-10-22-rbit-fork/workspace-tests.log"
    summary """
        Ubuntu 26.04.1, rustc 1.99.0, tree 2b9ca3f plus the rbit fork: 52 adapter tests passed (14 unit, 24 driver, 11 localhost, 3 multiblock). New announce unit tests: the GET keeps a passkey query and percent-encodes binary info hash and peer id, sets Host with a non-default port and Connection: close, and a bare host gets path /; https is refused with "https trackers need TLS support that this client does not build"; HTTP parsing accepts 200 with content length (ignoring trailing bytes) and chunked bodies with extensions, refuses 302, 404, truncated bodies, bad chunk sizes, a missing header terminator and a non-HTTP status line; the body parser reads compact IPv4 and IPv6 peers, dictionary peers, intervals and counts, and refuses failure reasons, missing interval, non-bencode and non-dictionary bodies. The loopback HTTP tracker fixtures in the driver, restore and multiblock tests discovered peers end to end through the new transport.
        """
}

record templartorrent.evidence.baseline-magnet-startup/1 : evidence {
    title "Ubuntu 26.04.1, i7-13700H, rustc 1.99.0, release profile, commit bf22b04, one sample each over owned loopback fixtures. Download: 196681 payload bytes, metadata 42229518 ns, magnet-to-first-verified-write 125156840 ns, total 330281810 ns, payload reservation high water 196608 B, engine owned peak sampled 65536 B, metadata permits 268660 B, sampled process RSS 6254592 B including fixture seeder and test harness. Seeding to a second Driver: 342743743 ns, upload reservation peak 98368 B, upload owned peak 81920 B, sampled RSS 6270976 B. Comparable to the 2026-10-15 samples (metadata 41.5 ms, first verified 123.4 ms, total 206 ms download; seed 340 ms); the download total is slower this time on a single sample and nothing was changed on that path, so this is spread, not a regression claim. Not application startup, not a public swarm, no optimization comparison."
    state verified
    result pass
    method command
    observed_at git:bf22b04d3d0a4923101a2c7aec5b0c6538da57d8
    command "cargo test --release -p templartorrent-rbit-adapter --test driver -- driver_magnet_to_first_verified_metrics driver_seeds_verified_disk_and_metadata_to_a_second_driver --nocapture"
    artifact "perf-results/2026-10-22-baselines/metrics.jsonl"
    summary """
        Ubuntu 26.04.1, i7-13700H, rustc 1.99.0, release profile, commit bf22b04, one sample each over owned loopback fixtures. Download: 196681 payload bytes, metadata 42229518 ns, magnet-to-first-verified-write 125156840 ns, total 330281810 ns, payload reservation high water 196608 B, engine owned peak sampled 65536 B, metadata permits 268660 B, sampled process RSS 6254592 B including fixture seeder and test harness. Seeding to a second Driver: 342743743 ns, upload reservation peak 98368 B, upload owned peak 81920 B, sampled RSS 6270976 B. Comparable to the 2026-10-15 samples (metadata 41.5 ms, first verified 123.4 ms, total 206 ms download; seed 340 ms); the download total is slower this time on a single sample and nothing was changed on that path, so this is spread, not a regression claim. Not application startup, not a public swarm, no optimization comparison.
        """
}

record templartorrent.evidence.baseline-microbench/1 : evidence {
    title "Ubuntu 26.04.1, i7-13700H (avx2, sha_ni), rustc 1.99.0, release profile, commit bf22b04, backend detected Avx2, synthetic dense arrays, 500 iterations. eligible p50 ns scalar/auto: 1k pieces 32/36; 100k 939/929 then 697/796 on a repeat run; 1M 7968/6418 with auto p95 20803 versus scalar 9433. reference_piece_pick p50: 1k 3034 ns; 100k 171793 ns then 348377 ns on the repeat with p95 3366847 ns; 1M 4786919 ns with p95 10686525 ns. Finding: the AVX2 eligibility kernel shows no consistent advantage over scalar at any size on this CPU, and the O(P) reference piece pick dominates by two to three orders of magnitude, reaching several milliseconds per pick at 1M pieces. Run-to-run spread at 100k was about 2x on p50, so single runs are not comparable; a laptop on a live desktop session, not an isolated device."
    state verified
    result pass
    method command
    observed_at git:bf22b04d3d0a4923101a2c7aec5b0c6538da57d8
    command "cargo run --release -p templartorrent-bench -- --pieces 100000 --iterations 500"
    artifact "perf-results/2026-10-22-baselines/microbench.jsonl"
    summary """
        Ubuntu 26.04.1, i7-13700H (avx2, sha_ni), rustc 1.99.0, release profile, commit bf22b04, backend detected Avx2, synthetic dense arrays, 500 iterations. eligible p50 ns scalar/auto: 1k pieces 32/36; 100k 939/929 then 697/796 on a repeat run; 1M 7968/6418 with auto p95 20803 versus scalar 9433. reference_piece_pick p50: 1k 3034 ns; 100k 171793 ns then 348377 ns on the repeat with p95 3366847 ns; 1M 4786919 ns with p95 10686525 ns. Finding: the AVX2 eligibility kernel shows no consistent advantage over scalar at any size on this CPU, and the O(P) reference piece pick dominates by two to three orders of magnitude, reaching several milliseconds per pick at 1M pieces. Run-to-run spread at 100k was about 2x on p50, so single runs are not comparable; a laptop on a live desktop session, not an isolated device.
        """
}


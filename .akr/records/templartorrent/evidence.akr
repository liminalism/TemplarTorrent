    summary """
        Ubuntu 26.04.1, Linux 7.0.0-31-generic, i7-13700H, rustc 1.99.0, commit 9b0874f. The command passed 1 test in 0.26s. While the peer was still connected, peer status showed hash_failures 1 and a measured round trip. The driver counted 1 hash failure. The recovered files matched the fixture, and the first requested piece was fetched twice. Preview tests, the rest of the workspace suite, and the release binary were not re-run.
        """
}

record templartorrent.evidence.dht-announce/1 : evidence {
    title "Loopback: node B's get_peers_and_announce announced port 51413 for an info hash to A, and node C's get_peers through A returned 127.0.0.1:51413. Internet, hotel wired IPv4 behind NAT, Ubuntu ISO torrent for 240 s: the routing table reached 61 nodes and real nodes accepted 6 announce_peer queries. The download held 18.4 to 19.0 MB/s from 43 peers, 34 of them MSE-encrypted, and verified 2.32 GB before the time limit."
    state verified
    result pass
    method command
    observed_at git:1ba08ab254839e103de22fe72eddfe30d3efdc80
    command "cargo test -p templartorrent-rbit-adapter --test dht; TT_INTERNET_TORRENT=... TT_INTERNET_SECONDS=240 cargo test --release -q -p templartorrent-rbit-adapter --test internet_smoke -- --ignored --nocapture"
    artifact "perf-results/2026-10-26-wired/run1-announce.log"
    summary """
        Loopback: node B's get_peers_and_announce announced port 51413 for an info hash to A, and node C's get_peers through A returned 127.0.0.1:51413. Internet, hotel wired IPv4 behind NAT, Ubuntu ISO torrent for 240 s: the routing table reached 61 nodes and real nodes accepted 6 announce_peer queries. The download held 18.4 to 19.0 MB/s from 43 peers, 34 of them MSE-encrypted, and verified 2.32 GB before the time limit.
        """
}


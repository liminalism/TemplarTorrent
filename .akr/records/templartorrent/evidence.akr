record templartorrent.evidence.formats-hybrid-many-files/1 : evidence {
    title "A hybrid torrent with a 45536-byte pad file between two real files downloaded and verified over loopback; both files matched, no .pad path was created, and verified_bytes equalled wanted_bytes at 50000. A 300-file v1 torrent added from its bytes transferred, and every file matched. Pure v2 bytes and a btmh-only magnet were refused with 'pure v2 ... not supported' before any destination existed. Two rbit hybrid bugs were fixed on the way: the parser's expected v1 piece count and the builder's padded last piece."
    state verified
    result pass
    method command
    observed_at git:e6350dab1f5090a8160cc69f3238475633da1e7a
    command "cargo test -p templartorrent-rbit-adapter --test driver driver_downloads_hybrid_with_pad_files_through_its_v1_view driver_transfers_a_torrent_with_three_hundred_files driver_rejects_pure_v2_before_any_storage_exists"
    artifact "perf-results/2026-10-25-internet/test-workspace.log"
    summary """
        A hybrid torrent with a 45536-byte pad file between two real files downloaded and verified over loopback; both files matched, no .pad path was created, and verified_bytes equalled wanted_bytes at 50000. A 300-file v1 torrent added from its bytes transferred, and every file matched. Pure v2 bytes and a btmh-only magnet were refused with 'pure v2 ... not supported' before any destination existed. Two rbit hybrid bugs were fixed on the way: the parser's expected v1 piece count and the builder's padded last piece.
        """
}


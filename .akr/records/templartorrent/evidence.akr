record templartorrent.evidence.step4-forced-crash-restart/1 : evidence {
    title "Same host. New test driver_restart_after_forced_process_kill_rechecks_and_completes spawns the test binary as a child process running a real Driver against an owned loopback seeder that delays each block 40 ms, SIGKILLs the child after 9 to 12 of 13 blocks were served, then a fresh Driver opens the same destination with ExistingData::Recheck, adopts at least one full piece from disk, requests at most 9 blocks and finishes with files equal to the fixture. Passed 5 of 5 repeated runs at about 0.7 s each. The kill is a process kill, not an in-process drop; no power loss or filesystem fault injection."
    state verified
    result pass
    method command
    observed_at git:21f43b73b4c20f8cbd742cb7dc162a2893906a3e
    command "cargo test -p templartorrent-rbit-adapter --test driver"
    artifact "perf-results/2026-10-22-step4-checks/adapter-driver-tests.log"
    summary """
        Same host. New test driver_restart_after_forced_process_kill_rechecks_and_completes spawns the test binary as a child process running a real Driver against an owned loopback seeder that delays each block 40 ms, SIGKILLs the child after 9 to 12 of 13 blocks were served, then a fresh Driver opens the same destination with ExistingData::Recheck, adopts at least one full piece from disk, requests at most 9 blocks and finishes with files equal to the fixture. Passed 5 of 5 repeated runs at about 0.7 s each. The kill is a process kill, not an in-process drop; no power loss or filesystem fault injection.
        """
}

record templartorrent.evidence.step4-offline-country-client/1 : evidence {
    title "Same host. 21 production client tests passed including geo tests: special addresses never resolve to a country, ISO codes must be two ASCII letters, a missing database reports failure without blocking, the lookup cache counts misses and stays bounded, and explicit path beats environment and defaults; the worker reports \"not loaded\" without a database. A source grep of geo.rs and the adapter lib for reqwest, hyper, http, dns, lookup_host, TcpStream and UdpSocket found no match; client_name takes only the sanitized extension-handshake string capped at 80 characters with an Unknown fallback. Peer-ID client fallback is not implemented. No live MMDB lookup was run because no database is bundled."
    state verified
    result pass
    method command
    observed_at git:21f43b73b4c20f8cbd742cb7dc162a2893906a3e
    command "cargo test -p templartorrent"
    artifact "perf-results/2026-10-22-step4-checks/offline-lookup-audit.log"
    summary """
        Same host. 21 production client tests passed including geo tests: special addresses never resolve to a country, ISO codes must be two ASCII letters, a missing database reports failure without blocking, the lookup cache counts misses and stays bounded, and explicit path beats environment and defaults; the worker reports "not loaded" without a database. A source grep of geo.rs and the adapter lib for reqwest, hyper, http, dns, lookup_host, TcpStream and UdpSocket found no match; client_name takes only the sanitized extension-handshake string capped at 80 characters with an Unknown fallback. Peer-ID client fallback is not implemented. No live MMDB lookup was run because no database is bundled.
        """
}


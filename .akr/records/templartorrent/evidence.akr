record templartorrent.evidence.https-rustls-audit/1 : evidence {
    title "rustls 0.23.46 and aws-lc-sys are in the graph; ring and reqwest are not built"
    state verified
    result pass
    method command
    observed_at git:3bb7995e5291fe34eae6f636c6a6687b7a149fd0
    command "cargo tree --workspace --offline -i rustls"
    summary """
        Same tree. cargo tree --workspace --offline -i rustls shows rustls 0.23.46 under the adapter and the application, via tokio-rustls 0.26.6. cargo tree -i aws-lc-sys shows aws-lc-sys 0.46.0 under aws-lc-rs 1.18.2, rustls and rustls-webpki. cargo tree -i ring prints nothing. cargo tree -i reqwest reports that the package did not match. Cargo.lock still names ring as an unused optional dependency of rustls-webpki. cargo clippy -p templartorrent-rbit-adapter --all-targets --offline -- -D warnings finished with no diagnostics. Brotli is not a feature.
        """
}


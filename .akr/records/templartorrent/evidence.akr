record templartorrent.evidence.multi-lease-before-after/1 : evidence {
    title "Ubuntu 26.04.1 i7-13700H, rustc 1.99.0, release, tree 3ed3709 plus the changes. 2048-piece 32 MiB scenario over two loopback seeders, three runs each: before 42.27/42.30/42.23 s at 794 KB/s with payload reservation peak 98304 B and RSS about 38.9 MB; after 5.25/5.30/5.26 s at 6.34 to 6.39 MB/s with reservation peak 1081344 B and RSS about 40.2 MB. Eight times faster with the reservation still far inside the 48 MiB budget. The 4-piece small scenario run alone: total 164 to 165 ms against 328 ms before, first verified write unchanged at 123 ms, reservation peak 393216 B against 196608, RSS 5.4 MB unchanged. before-large-scenario.log and after-small-scenario-alone.log hold the raw lines."
    state verified
    result pass
    method command
    observed_at git:3ed370905442455c343eb05d181a71b5c8c657bf
    command "cargo test --release -p templartorrent-rbit-adapter --test driver -- driver_large_piece_count_scenario_metrics --nocapture"
    artifact "perf-results/2026-10-22-multi-lease/after-large-scenario.log"
    summary """
        Ubuntu 26.04.1 i7-13700H, rustc 1.99.0, release, tree 3ed3709 plus the changes. 2048-piece 32 MiB scenario over two loopback seeders, three runs each: before 42.27/42.30/42.23 s at 794 KB/s with payload reservation peak 98304 B and RSS about 38.9 MB; after 5.25/5.30/5.26 s at 6.34 to 6.39 MB/s with reservation peak 1081344 B and RSS about 40.2 MB. Eight times faster with the reservation still far inside the 48 MiB budget. The 4-piece small scenario run alone: total 164 to 165 ms against 328 ms before, first verified write unchanged at 123 ms, reservation peak 393216 B against 196608, RSS 5.4 MB unchanged. before-large-scenario.log and after-small-scenario-alone.log hold the raw lines.
        """
}

record templartorrent.evidence.multi-lease-regressions/1 : evidence {
    title "Same host and tree: 158 workspace tests passed, formatting and all-target Clippy with warnings denied clean after a filter_map lint fix, release build ok. Four assertions that encoded the single-lease behaviour were restated: the assembly test now allows up to two piece working sets at the peak, the engine round-trip and expiry tests expect the four small pieces to pipeline in round one with the pipelined pieces' permits still held, and the localhost bounded-memory test caps the peak at the whole 50 KB fixture's working set."
    state verified
    result pass
    method command
    observed_at git:3ed370905442455c343eb05d181a71b5c8c657bf

akr 0.1
project templartorrent

record templartorrent.work.complete-piece-assembly/1 : work {
    title "Bounded complete-piece transfer and cancellation"
    state completed
    intent """
        Replace per-block verification with budget-admitted complete-piece assembly,
        retain the scalar file-order oracle, fence cancellation and worker writes,
        and exercise ordinary v1 piece sizes over real deterministic localhost peers.
        Keep this milestone headless: the existing PixelKit live mode still has no Add
        or production transport and must not be represented as a working client.
        """
    acceptance {
        check assembly {
            statement """
                Complete-piece assembly handles out-of-order blocks, bounded pipeline refill, short tails, file promotion and exact verification before writes.
                """
            method command
            command "cargo test -p templartorrent-engine --test assembly"
            verified_by [ @templartorrent.evidence.complete-piece-root/1 ]
        }
        check lifecycle {
            statement """
                Fake-clock tests cover cancellation, timeout, low-rate progress and global reservation ownership across settings changes.
                """
            method command
            command "cargo test --workspace --locked"
            verified_by [ @templartorrent.evidence.complete-piece-root/1 ]
        }
        check wire {
            statement """
                Real rbit localhost transfers use 256 KiB pieces, a local tracker, verified file writes, corruption retry and interrupted disk resume.
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test multiblock --locked"
            verified_by [ @templartorrent.evidence.complete-piece-wire/1 ]
        }
    }
    part_of [ @templartorrent.milestone.native-app-wiring ]
}

record templartorrent.work.driver-seeding/1 : work {
    title "Verified bounded Linux driver seeding"
    state completed
    intent """
        Implement Linux Driver upload/seeding with verified disk reads, shared memory
        and upload-rate admission, bounded peer queues and incoming v1 routing.
        Preserve private-source restrictions, quiescent pause/remove and no-listener
        Complete status. Windows is optional under the latest explicit user scope.
        """
    acceptance {
        check policy {
            statement """
                Fake-clock upload admission and wire tests cover bounds, corruption, pause, cancellation, limits and private ingress.
                """
            method command
            command "cargo test --workspace --locked"
            verified_by [ @templartorrent.evidence.driver-seeding-regressions/1 ]
        }
        check seed {
            statement """
                Real rbit localhost peers fetch verified bytes from Driver, including restart-adopted data and metadata.
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test driver --locked"
            verified_by [ @templartorrent.evidence.driver-seeding-path/1 ]
        }
    }
    after [ @templartorrent.work.rbit-driver ]
    part_of [ @templartorrent.milestone.native-app-wiring ]
}


    title "Engine session skeleton"
    state completed
    intent """
        Engine skeleton: one lease coordinator, one session arbiter, peer actors owning sockets, bounded disk/hash workers, generation-tagged events.
        """
    part_of [ @templartorrent.milestone.local-v1-transfer ]
}

record templartorrent.work.file-storage/1 : work {
    title "File-backed piece storage"
    state completed
    intent """
        File-backed PieceSink/PieceReader: validated no-follow paths, explicit length-mismatch errors instead of silent overwrite, v1 piece mapping with a clear oversize-piece gate, per-write durability sync, temp-dir transfer and resume tests.
        """
    part_of [ @templartorrent.milestone.native-app-wiring ]
}

record templartorrent.work.peer-preference/1 : work {
    title "Local peer preference: Prefer/Normal/Avoid/Block through Driver, worker and Peers tab"
    state completed
    scope [
        path "crates/templartorrent-engine/src/peer.rs",
        path "crates/templartorrent-engine/src/session.rs",
        path "integration/rbit-adapter/src/driver.rs",
        path "integration/rbit-adapter/tests/driver.rs",
        path "integration/templartorrent/src/**"
    ]
    intent """
        Make Command::SetPeerPreference real end to end. The Driver keeps a bounded per-job preference table keyed by peer IP: Block closes matching connections and refuses reconnection, incoming and tracker-supplied candidates; Avoid narrows the engine request pipeline to two blocks; Prefer is retained first when connection caps shrink and unchoked first when upload slots are scarce. The worker routes the command with a real ack and peer rows carry the preference and socket; the Peers tab selects a row and offers the four actions with the IP-scope and sole-supplier caveat visible.
        """
    note """
        Deliberately not automatic scoring: no throughput, RTT or reliability metrics drive these choices yet. Keying by IP is chosen so an incoming peer cannot evade Block by reconnecting from another ephemeral port.
        """
    acceptance {
        check client {
            statement """
                Production client tests pass with the worker routing SetPeerPreference to the Driver and the Peers tab label text no longer calling the feature unavailable.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.peer-preference-client/1 ]
        }
        check driver {
            statement """
                A new adapter driver test passes covering Avoid pipeline narrowing, Prefer retention under a shrunken cap, Block disconnecting and refusing reconnection, and Normal restoring the peer.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.peer-preference-driver/1 ]
        }
        check gates {
            statement """
                Formatting and all-target Clippy with warnings denied pass in the root workspace and both integrations.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.peer-preference-gates/1 ]
        }
    }
    part_of [ @templartorrent.milestone.safety-and-peer-policy ]
}

record templartorrent.work.rbit-driver/1 : work {
    title "Reusable bounded magnet and transfer driver"
    state completed
    intent """
        Move metadata exchange and verified payload pumping out of fixtures into a reusable
        rbit driver with explicit peer provenance, bounded parsers/queues, per-torrent hash
        routing and quiescent non-destructive removal. Test the same library path from an
        actual magnet through BEP-9 to verified files and disk recheck. No automatic public
        discovery, release claim or new GUI stack; the native-source gate remains open.
        """
    acceptance {
        check lifecycle {
            statement """
                Driver tests cover cancellation, non-destructive removal with closed handles, duplicate rejection, interrupted disk resume and private-source restrictions.
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --locked"
            verified_by [ @templartorrent.evidence.rbit-driver-path/1 ]
        }
        check magnet-driver {
            statement """
                A public library driver resolves bounded hash-verified magnet metadata and completes real localhost multi-block transfers into verified files; multiple jobs use their own hashes.
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test driver --locked"
            verified_by [ @templartorrent.evidence.rbit-driver-path/1 ]
        }
        check regression {
            statement """
                Root and both integration workspaces pass tests, formatting and Clippy on the pinned Linux toolchain; unsupported paths remain explicit.
                """
            method command
            command "cargo test --workspace --locked"
            verified_by [ @templartorrent.evidence.rbit-driver-regressions/1 ]
        }
    }
    after [ @templartorrent.work.complete-piece-assembly ]
    part_of [ @templartorrent.milestone.native-app-wiring ]
}

record templartorrent.work.resume-recheck/1 : work {
    title "Resume recheck without rewrite"
    state completed
    intent """
        Resume scan: Session::recheck reads existing on-disk pieces via PieceReader, checks exact length, hash-verifies via PieceVerifier, and adopts matches without re-request or rewrite; missing/short/corrupt stay unverified, read errors mark Error, oversized pieces skip under payload budget.
        """
    part_of [ @templartorrent.milestone.local-v1-transfer ]
}

record templartorrent.work.seam-hardening/1 : work {
    title "Rbit seam hardening + fault injection"
    state completed
    intent """
        Rbit seam audit per INTEGRATION.md C (framing cancellation, directional ext IDs, bounded announce, blame handling) plus fault-injection and adversarial fixtures.
        """
    after [ @templartorrent.work.transfer-seed-loop ]
    part_of [ @templartorrent.milestone.local-v1-transfer ]
}

record templartorrent.work.session-persistence/1 : work {
    title "Driver job records, client session store, worker restore and save hooks"
    state completed
    scope [
        path "crates/templartorrent-engine/src/session.rs",
        path "integration/rbit-adapter/src/driver.rs",
        path "integration/rbit-adapter/src/torrent.rs",
        path "integration/rbit-adapter/tests/driver.rs",
        path "integration/templartorrent/**"
    ]
    intent """
        Driver::export_job and Driver::restore_job move a job through a JobRecord (info hash, metainfo envelope, destination, paused intent, bootstrap flag, file selection and order, tracker URLs with origin, peer preferences) with the restore built from stored bytes, a disk recheck and no peer contact. The client gains a persist module writing <hash>.job text records, <hash>.torrent bytes and a settings file atomically under the XDG data directory, bounded on read. The worker restores settings and jobs at start, saves the affected job after each accepted state-changing command, saves settings after limit changes and deletes records on remove.
        """
    note """
        Every launch rechecks from disk; no resume bitmap is persisted. A restored job with no known peers relies on its trackers announcing on their normal schedule.
        """
    acceptance {
        check client {
            statement """
                Client tests cover record and settings roundtrip, atomic write, malformed and oversized rejection, and a worker that restores a saved complete job and settings, removes the record on Remove and saves changed limits.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.persistence-client/1 ]
        }
        check driver {
            statement """
                Adapter test exports and restores records for a completed and a paused partial job, verifies selection, order, preferences, destination and adopted bytes, rejects a tampered record and a duplicate, and completes the partial job through its saved tracker after resume.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.persistence-driver/1 ]
        }
        check gates {
            statement """
                Formatting and all-target Clippy with warnings denied pass in the root workspace.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.persistence-gates/1 ]
        }
    }
    part_of [ @templartorrent.milestone.session-persistence ]
}


record templartorrent.work.https-rustls/1 : work {
    title "HTTPS tracker announces through rustls 0.23.46"
    state completed
    scope [
        path "Cargo.lock",
        path "Cargo.toml",
        path "README.md",
        path "docs/DEPENDENCY-AUDIT.md",
        path "integration/rbit-adapter/**"
    ]
    intent """
        Replace the visible HTTPS refusal with a rustls 0.23.46 client on the existing bounded announce transport. Pin that release, enable only std, tls12 and aws_lc_rs, verify server certificates against the webpki roots, keep redirects refused and the 64 KiB cap, and prove a localhost handshake accepts a matching certificate and rejects a name mismatch. ring and reqwest stay out of the graph.
        """
    note """
        aws-lc-sys is the native code rustls 0.23.46 uses for cryptography. It is recorded as an accepted boundary, not as a pure-Rust stack. Brotli stays disabled.
        """
    acceptance {
        check localhost-tls {
            statement """
                A localhost HTTPS announce completes against a certificate whose name matches the tracker host, and a certificate for a different name fails the handshake before any announce body is parsed.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --offline --lib -- announce::"
            verified_by [ @templartorrent.evidence.https-rustls/1 ]
        }
        check native-boundary {
            statement """
                cargo tree on the workspace shows rustls 0.23.46 and aws-lc-sys, and shows no ring and no reqwest.
                """
            method command
            command "cargo tree --workspace --offline -i rustls"
            verified_by [ @templartorrent.evidence.https-rustls-audit/1 ]
        }
    }
    depends_on [ @templartorrent.decision.fork-rbit-for-native-gate ]
}

record templartorrent.work.multi-lease-pipelining/1 : work {
    title "Lease several small pieces per peer so the request pipeline fills across pieces"
    state completed
    scope [
        path "crates/templartorrent-engine/src/lease.rs",
        path "crates/templartorrent-engine/src/session.rs",
        path "integration/rbit-adapter/tests/driver.rs"
    ]
    intent """
        The 2048-piece scenario showed the scheduler re-offering only one outstanding lease per peer: with 16 KiB pieces that is one block in flight per peer, so throughput is bounded by round-trip latency regardless of the eight-slot pipeline. Change the per-peer scheduling loop to re-offer every outstanding lease and then lease further pieces while the peer has free pipeline slots, bounded by the pipeline cap, the global active-piece cap and the payload budget as before. Record release before and after samples of the scenario and keep every existing lease, fencing and budget test green.
        """
    note """
        Opened 2026-10-22 from the scenario finding. Large pieces are unaffected because one lease already fills the pipeline.
        """
    acceptance {
        check before-after {
            statement """
                Three release runs of the 2048-piece scenario after the change show higher throughput than three runs before it, with payload reservation and RSS reported.
                """
            method command
            command "cargo test --release -p templartorrent-rbit-adapter --test driver -- driver_large_piece_count_scenario_metrics --nocapture"
            verified_by [ @templartorrent.evidence.multi-lease-before-after/1 ]
        }
        check regressions {
            statement """
                Engine lease, fencing, budget, assembly and adapter tests pass unchanged except where an assertion encoded the single-lease behaviour.
                """
            method command
            command "cargo test --workspace --all-targets"
            verified_by [ @templartorrent.evidence.multi-lease-regressions/1 ]
        }
    }
}

record templartorrent.work.optimistic-unchoke/1 : work {
    title "Rotating optimistic upload slot inside the configured slot total"
    state completed
    scope [
        path "integration/rbit-adapter/src/driver.rs",
        path "integration/rbit-adapter/tests/driver.rs"
    ]
    intent """
        DESIGN.md section 6: re-evaluate upload allocations periodically with one optimistic slot inside the configured total whenever slots are above zero and an interested peer would otherwise stay choked; with a one-slot limit rotate that slot instead of adding a second. The Driver orders slots as optimistic peer first, then Prefer, Normal, Avoid in stable connection order; the optimistic peer changes every 30 seconds (test-adjustable) to the next eligible peer by connection id that preference order leaves choked, and a vanished optimistic peer hands the slot back to preference order until the next rotation. The first interval after start runs on preference alone.
        """
    note """
        Done 2026-10-22. Still no throughput, RTT or reliability scoring; hysteresis comes from the stable preference order and the fixed rotation period.
        """
    acceptance {
        check gates {
            statement """
                Workspace tests, formatting and all-target Clippy with warnings denied pass.
                """
            method command
            command "cargo test --workspace --all-targets && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.optimistic-gates/1 ]
        }
        check rotation {
            statement """
                With one upload slot and two interested leeches, the slot moves from the first peer to the second and back on the rotation period, never two slots at once, and the preference test with the default period still unchokes the preferred peer first.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.optimistic-rotation/1 ]
        }
    }
}

record templartorrent.work.peer-id-client-fallback/1 : work {
    title "Name peers from their BEP 20 peer id when no extension handshake names them"
    state completed
    intent """
        Close the README's "peer-ID client fallback" gap: a peer that sends no extension handshake, or one without a v string, showed as Unknown in the Peers tab. Decode Azureus-style, Shadow-style, Mainline and the known fixed-prefix ids into a bounded clean label at connection time, keep the extension handshake's own name as the better source when it arrives, and never let the guess reach policy.
        """
    acceptance {
        check decoder {
            statement """
                Unit tests cover Azureus codes with dotted versions, Shadow and Mainline forms, fixed prefixes, unknown ids and ids carrying control bytes
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --lib client_id"
            verified_by [ @templartorrent.evidence.peer-id-client-fallback/1 ]
        }
        check wire {
            statement """
                Over a real loopback wire, fixture peers with the id -TR4040- and no extension name show as Transmission 4.0.4.0 in peer_status
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver driver_peer_preference_narrows_retains_and_blocks"
            verified_by [ @templartorrent.evidence.peer-id-client-fallback/1 ]
        }
    }
    author "Claude"
}

record templartorrent.work.peer-preference/1 : work {
    title "Local peer preference: Prefer/Normal/Avoid/Block through Driver, worker and Peers tab"
    state completed
    scope [
        path "crates/templartorrent-engine/src/peer.rs",
        path "crates/templartorrent-engine/src/session.rs",
        path "integration/rbit-adapter/src/driver.rs",
        path "integration/rbit-adapter/tests/driver.rs",
        path "integration/templartorrent/src/**"
    ]
    intent """
        Make Command::SetPeerPreference real end to end. The Driver keeps a bounded per-job preference table keyed by peer IP: Block closes matching connections and refuses reconnection, incoming and tracker-supplied candidates; Avoid narrows the engine request pipeline to two blocks; Prefer is retained first when connection caps shrink and unchoked first when upload slots are scarce. The worker routes the command with a real ack and peer rows carry the preference and socket; the Peers tab selects a row and offers the four actions with the IP-scope and sole-supplier caveat visible.
        """
    note """
        Deliberately not automatic scoring: no throughput, RTT or reliability metrics drive these choices yet. Keying by IP is chosen so an incoming peer cannot evade Block by reconnecting from another ephemeral port.
        """
    acceptance {
        check client {
            statement """
                Production client tests pass with the worker routing SetPeerPreference to the Driver and the Peers tab label text no longer calling the feature unavailable.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.peer-preference-client/1 ]
        }
        check driver {
            statement """
                A new adapter driver test passes covering Avoid pipeline narrowing, Prefer retention under a shrunken cap, Block disconnecting and refusing reconnection, and Normal restoring the peer.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.peer-preference-driver/1 ]
        }
        check gates {
            statement """
                Formatting and all-target Clippy with warnings denied pass in the root workspace and both integrations.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.peer-preference-gates/1 ]
        }
    }
    part_of [ @templartorrent.milestone.safety-and-peer-policy ]
}

record templartorrent.work.peer-score/1 : work {
    title "Rank upload slots by reliability, rare pieces, rate, and RTT"
    state completed
    scope [
        path "README.md",
        path "crates/templartorrent-engine/**",
        path "integration/rbit-adapter/**",
        path "integration/templartorrent/**"
    ]
    intent """
        Keep manual Prefer, Normal, and Avoid ahead of automatic order. Within a preference, rank a peer with fewer attributed hash failures first, then a peer who is the only supplier of a still-wanted piece, then verified payload rate, then a lower measured block round trip. Seeding uses upload rate and does not use download rate or download round trip. One attributed failure demotes that peer only; it does not disconnect them, and it does not blame any other peer. An unmeasured round trip never sorts as instant.
        """
    note """
        No per-block resume journal, webseed, UPnP, or Windows paste. reqwest stays out of the graph. Quarantine is the rank, not a ban.
        """
    acceptance {
        check corrupt-peer {
            statement """
                A driver transfer whose first block is corrupted once records one hash failure on that peer and a measured round trip, and the recovered files match the fixture.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --offline --test driver driver_corruption_retries_verified_piece_without_corrupting_files -- --test-threads=1"
            verified_by [ @templartorrent.evidence.corrupt-peer/1 ]
        }
        check gates {
            statement """
                Clippy with denied warnings is clean for the engine, the rbit adapter, and the application, all targets, offline.
                """
            method command
            command "cargo clippy -p templartorrent-engine -p templartorrent-rbit-adapter -p templartorrent --all-targets --offline -- -D warnings"
            verified_by [ @templartorrent.evidence.peer-score-gates/1 ]
        }
        check slot-order {
            statement """
                Upload-slot order is preference, then fewer attributed hash failures, then a sole supplier of a still-wanted piece, then higher payload rate, then lower measured block round trip, then connection order. Seeding uses upload rate and ignores download rate and download round trip. An unmeasured round trip sorts after a measured one at the same rate.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --offline --lib slot_order -- --test-threads=1"
            verified_by [ @templartorrent.evidence.slot-order/1 ]
        }
        check sole-supplier {
            statement """
                A peer is a sole supplier only while some still-wanted, unverified piece has availability 1 and that peer announced it. A second announcer or verification of that piece clears the flag.
                """
            method command
            command "cargo test -p templartorrent-engine --offline --lib sole_wanted_supplier -- --test-threads=1"
            verified_by [ @templartorrent.evidence.sole-supplier/1 ]
        }
    }
    derived_from [ @templartorrent.observation.complete-piece-status ]
}

record templartorrent.work.picker-buckets/1 : work {
    title "Per-rank availability buckets for the live piece picker, oracle-checked"
    state completed
    scope [
        path "crates/templartorrent-bench/src/main.rs",
        path "crates/templartorrent-core/src/sequence.rs",
        path "crates/templartorrent-engine/src/session.rs"
    ]
    intent """
        Replace the per-call full scan in the live engine's piece selection with an incrementally maintained structure keyed by (piece_rank, availability) so a pick is proportional to candidates in the lowest non-empty rank bucket rather than to the piece count. Keep the scalar Sequence picker unchanged as the oracle, add randomized equivalence tests, extend templartorrent-bench with the new picker beside reference_piece_pick, and gather repeated before/after runs at 1k, 100k and 1M pieces plus a release localhost scenario.
        """
    note """
        Not started. Baseline on 2026-10-22: reference pick p50 3 us at 1k, 170 to 350 us at 100k, 4.8 ms at 1M pieces. AVX2 eligibility showed no consistent gain, so this is the first optimization target.
        """
    acceptance {
        check bench {
            statement """
                Bench JSONL shows the new picker's p50 and p95 below the baseline reference pick at 100k and 1M pieces across at least three runs each.
                """
            method command
            command "cargo run --release -p templartorrent-bench -- --pieces 1000000 --iterations 500"
            verified_by [ @templartorrent.evidence.picker-microbench/1 ]
        }
        check equivalence {
            statement """
                Randomized oracle tests pass with the new picker producing the oracle's pick for every tried state.
                """
            method command
            command "cargo test --workspace"
            verified_by [ @templartorrent.evidence.picker-oracle-equivalence/1 ]
        }
    }
    part_of [ @templartorrent.milestone.picker-optimization ]
}

record templartorrent.work.power-loss-batched-sync/1 : work {
    title "Prove the batched sync against power loss with a fault-injected disk"
    state completed
    intent """
        Close the open gate on the batched write path (milestone loopback-throughput dropped the per-piece fdatasync): show that a resume bitmap written at a checkpoint names only pieces the checkpoint's sync made durable, so a power loss after the checkpoint cannot leave a trusted bit over bytes that never reached the disk. The forced-kill test could not show this because the page cache survives a killed process. Add a disk observer seam to the storage crate, a shadow that models durable versus volatile bytes, and a driver test that loses power after a checkpoint, restores the durable image with the checkpoint's mtimes, restarts from the record and completes with matching bytes; and a negative control that forges one lost piece into the bitmap and shows the resulting hole, proving the harness can tell.
        """
    acceptance {
        check gates {
            statement """
                Storage and adapter suites, format check and Clippy with warnings denied pass with the observer seam in place
                """
            method command
            command "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test -p templartorrent-storage -p templartorrent-rbit-adapter --no-fail-fast"
            verified_by [ @templartorrent.evidence.power-loss-batched-sync/1 ]
        }
        check power-loss {
            statement """
                After a simulated power loss the restart trusts the checkpoint bitmap (resume_scan note None, trusted equals the bitmap's pieces), completes, and the files match; the same run with a forged bit over a lost piece ends with zeros in that piece
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver driver_resume_bitmap_survives_a_power_loss_after_the_sync"
            verified_by [ @templartorrent.evidence.power-loss-batched-sync/1 ]
        }
    }
    part_of [ @templartorrent.milestone.loopback-throughput ]
    author "Claude"
}

record templartorrent.work.rate-ranked-slots/1 : work {
    title "Per-peer payload rates, rate-ranked regular upload slots with hysteresis, rates in the Peers tab"
    state completed
    scope [
        path "integration/rbit-adapter/src/driver.rs",
        path "integration/rbit-adapter/tests/driver.rs",
        path "integration/templartorrent/src/ui.rs",
        path "integration/templartorrent/src/worker.rs"
    ]
    intent """
        DESIGN.md section 6: compute per-peer rates from monotonic deltas with short smoothing and use verified useful throughput in upload allocation. The Driver counts payload bytes per wire in both directions, folds a 2-second window into a 3:1 blended rate, and ranks regular upload slots by preference, then by the rate the peer gives us while downloading (or takes from us while seeding), then by connection order, re-evaluating every 10 seconds so a single fast step cannot churn slots; a manual preference change bypasses the hold. PeerStatus and the Peers tab show the rates instead of dashes. A 2048-piece, 32 MiB localhost scenario test prints metrics for the scheduler path.
        """
    note """
        2026-10-22. RTT and reliability are still not scored; the pure ranking function is unit-tested because the Driver uses real time.
        """
    acceptance {
        check gates {
            statement """
                Workspace tests, formatting and Clippy with warnings denied pass.
                """
            method command
            command "cargo test --workspace --all-targets && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.rate-ranking-gates/1 ]
        }
        check ranking {
            statement """
                The pure ranking test orders preference, then descending rate, then arrival; the slot tests still pass; the 2048-piece scenario completes with every piece requested exactly once and prints its metric line.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter"
            verified_by [ @templartorrent.evidence.rate-ranking/1 ]
        }
    }
}


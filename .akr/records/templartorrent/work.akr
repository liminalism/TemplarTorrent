record templartorrent.work.ui-state-persistence/1 : work {
    title "Persist window size and inspector split ratio across launches"
    state completed
    scope [
        path "integration/templartorrent/src/main.rs",
        path "integration/templartorrent/src/persist.rs",
        path "integration/templartorrent/src/ui.rs"
    ]
    intent """
        DESIGN.md section 2: save splitter ratio and window geometry and clamp them on load. The session store gains a `ui` file (logical width and height, inspector split fraction) written atomically on exit from the last rendered size and pane layout; main.rs reads it before creating the window and falls back to the 300x500 default; values are clamped to 260..=16384 by 320..=16384 and 0.1..=0.9.
        """
    note """
        Done 2026-10-22. Verified headlessly (unit tests on encode/decode/clamp and store roundtrip); the on_exit save path itself was not exercised in a window because closing the window cannot be automated here.
        """
    acceptance {
        check gates {
            statement """
                Workspace tests, formatting, Clippy with warnings denied and the release build pass.
                """
            method command
            command "cargo test --workspace --all-targets && cargo clippy --workspace --all-targets -- -D warnings && cargo build --release -p templartorrent"
            verified_by [ @templartorrent.evidence.ui-state-gates/1 ]
        }
        check roundtrip {
            statement """
                Client tests show the ui record encoding and decoding, hostile values clamped, unknown versions rejected, and the store returning None before a save and the saved size after.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.ui-state-roundtrip/1 ]
        }
    }
}

record templartorrent.work.window-close-and-paste/1 : work {
    title "Evidence for window close and native magnet paste"
    state completed
    scope [ path "integration/templartorrent/**" ]
    intent """
        Prove the PixelKit close path and Linux magnet paste that are already wired. App::on_exit, the method close_slot calls, saves the last rendered logical size and inspector split, shuts the worker so the resume bitmap is written, and stops the activation listener. With the Add dialog focused on the magnet field, Ctrl+V through the attached system clipboard worker inserts the clipboard text and leaves no clipboard error. The test restores the previous clipboard text.
        """
    note """
        No per-block journal, RTT scoring, webseed, or UPnP. The paste check uses the Linux system clipboard and restores the previous text; an image-only clipboard cannot be put back. Windows paste stays untested. A compositor without data-control cannot serve this check.
        """
    acceptance {
        check close-persists {
            statement """
                After one render, App::on_exit writes that frame's logical width, height and inspector split, removes the activation socket, and leaves a resume bitmap whose durability barrier is set and whose verified pieces are recorded.
                """
            method command
            command "cargo test -p templartorrent --offline --lib window_close_saves_layout_and_resume -- --test-threads=1"
            verified_by [ @templartorrent.evidence.window-close/1 ]
        }
        check gates {
            statement """
                Clippy with denied warnings is clean for the application, all targets, offline.
                """
            method command
            command "cargo clippy -p templartorrent --all-targets --offline -- -D warnings"
            verified_by [ @templartorrent.evidence.window-close-gates/1 ]
        }
        check native-paste {
            statement """
                With the system clipboard set to a magnet and the Add dialog focused on the magnet field, Ctrl+V through the attached clipboard worker inserts that magnet and reports no clipboard error. The previous clipboard text is restored.
                """
            method command
            command "cargo test -p templartorrent --offline --lib paste_magnet_from_the_system_clipboard -- --test-threads=1"
            verified_by [ @templartorrent.evidence.native-paste/1 ]
        }
    }
    derived_from [ @templartorrent.observation.complete-piece-status ]
}

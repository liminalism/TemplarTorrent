        @templartorrent.evidence.write-path-safety-tests
    ]
}

record templartorrent.observation.complete-piece-status/15 : observation {
    title "Linux client downloads a public 6.5 GB ISO from the Internet swarm; remaining boundaries"
    state superseded
    statement """
        2026-10-26, Linux x86_64 Ubuntu 26.04.1, i7-13700H, rustc 1.99.0, committed on master at e6350da. The opt-in Internet smoke test downloaded the user-permitted Ubuntu 26.04.1 desktop ISO in 519 s. That is 6482409472 bytes, every piece verified by the client and again independently, at a 19.6 MB/s peak from up to 47 peers, with RSS under 37 MB. The network was IPv4-only Wi-Fi, so peers came from DHT and PEX; the Ubuntu tracker gave 1 peer over IPv4. MSE negotiated RC4 with 35 of 38 real peers. In place now:
        - .torrent files added from their info dictionary; parallel magnet metadata.
        - Announces off the step loop, per address family, over HTTP(S) and UDP.
        - A 2048-candidate pool dialled in the background with backoff.
        - DHT get_peers (rbit fork fixes) and PEX, public jobs only; MSE with plaintext fallback.
        - A fixed dual-stack listen port and encryption setting, both persisted; peer ID -TE0100-.
        - Up to 4096 files; hybrid torrents through the v1 view with BEP 47 pad files.
        Ten fuzz targets; 222 workspace tests pass.
        Remaining boundaries:
        - One unreproduced stall (observation internet-download-stall).
        - No DHT announce_peer, so others find us only via trackers and PEX.
        - No UPnP/NAT-PMP and no incoming peers observed; no uTP, no webseeds, no pure v2.
        - The full IPv6 path was not exercised by the client (VPN down).
        - Pieces written after the last checkpoint are rechecked; file identity is not a content hash.
        - The rbit fork must be re-applied on upgrade.
        - Windows paste and a real window event loop are untested; the GUI was not driven against the Internet.
        """
    observed_at git:e6350dab1f5090a8160cc69f3238475633da1e7a
    method command
    watches [ "crates/**", "integration/**", "vendor/**", "fuzz/**" ]
    supersedes [ @templartorrent.observation.complete-piece-status/14 ]
    verified_by [
        @templartorrent.evidence.formats-hybrid-many-files,
        @templartorrent.evidence.fuzz-bounded-run,
        @templartorrent.evidence.https-rustls,
        @templartorrent.evidence.internet-ubuntu-download,
        @templartorrent.evidence.mse-tests-and-real-peers,
        @templartorrent.evidence.pex-loopback-and-dht-internet,
        @templartorrent.evidence.public-swarm-gates,
        @templartorrent.evidence.udp-family-announce-tests,
        @templartorrent.evidence.write-path-before-after
    ]
}


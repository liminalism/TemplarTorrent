akr 0.1
project templartorrent

record templartorrent.observation.backend-session-comparison/1 : observation {
    title "Rbit orchestration boundary and librqbit session alternative"
    state verified
    statement """
        Reviewed rbit 0.2.2 docs (https://docs.rs/rbit/0.2.2/rbit/) and the installed
        registry source: rbit supplies protocol primitives, leaving piece selection,
        peer coordination, bandwidth and lifecycle to the application. Current local
        integration uses those real primitives; it does not assume an upstream Session.

        Alternative reviewed: librqbit 9.0.1 has Session::new, add_torrent from magnet,
        completion waiting, pause/unpause/delete, session limits and persistence options
        in its public documentation (https://docs.rs/librqbit/9.0.1/librqbit/ and
        https://docs.rs/librqbit/9.0.1/librqbit/struct.Session.html). Inference: it could
        remove substantial generic session/lifecycle infrastructure. No compatibility
        proof was established for this project's exact file-rank scheduler, global
        payload ownership, private discovery and strict native-source gate. Its desktop
        UI is a separate Tauri/web application; that UI is not an option for this contract.
        The library can be considered separately from its UI, but replacing rbit conflicts
        with AGENTS.md's explicit backend constraint. Retained rbit and did not add a
        second backend, external torrent process or another GUI stack.
        """
    observed_at git:72b01427f8bb0ef32794e5ecc67fe6a3dae2912e
    method manual
    watches [ "AGENTS.md", "DESIGN.md", "integration/rbit-adapter/Cargo.toml" ]
}

record templartorrent.observation.complete-piece-status/1 : observation {
    title "Multi-block v1 execution evidence and remaining engine boundary"
    state superseded
    statement """
        2026-10-15 uncommitted working tree on Linux x86_64/Rust 1.99.0: complete-piece
        assembly replaces per-block hash/write submission. Requests reserve a full 3x
        piece working set first, peer pipelines remain eight blocks, active pieces are
        capped at 64, and unsupported working sets fail admission explicitly. Received
        spans are removed from leases, duplicate inbox blocks are dropped before queueing,
        policy changes/pause/removal cancel queued work, and ordinary file promotion no
        longer fences useful work held by another peer. Global ByteBudget changes preserve
        the same ownership pool. Storage accepts up to the engine piece-size bound and
        reads directly into one resume buffer. Default 48 MiB admits at most 16 MiB pieces
        under this conservative working-set rule; larger pieces need streaming verification.

        Observed commands, fixtures, metrics, failures and environment are in
        perf-results/2026-10-15-assembly/handoff.json and sibling raw logs/metrics.jsonl.
        93 tests passed across three workspaces; format and Clippy passed. The new HTTP
        tracker test parses a magnet but uses preloaded metainfo; BEP-9 metadata exchange
        still lives in a separate localhost test harness. Actual rbit reuse is TCP/wire,
        tracker, metainfo/magnet, extension/metadata primitives, not a session API or DHT.

        This is not a finished client. Next is a bounded production metadata/transport
        coordinator (including per-torrent verifier routing), then real PixelKit Add,
        folder/limits/files/removal workflow on that driver. Current GUI Add and transport
        are unwired; Reannounce bridge admission still does not perform a network announce.
        Protected handle-relative storage/deletion, alias/duplicate writers, bounded file
        handles, resume journals/crash recovery, upload policy, UDP fixtures, v2/hybrid
        gates and Windows execution remain open. ring remains a strict native-source
        release blocker. Existing README/AGENTS initial status is a historical handoff,
        not the current execution evidence; no release binary or public swarm claim.
        """
    observed_at git:72b01427f8bb0ef32794e5ecc67fe6a3dae2912e
    method instrumented
    watches [
        "crates/templartorrent-engine/**",
        "crates/templartorrent-storage/**",
        "crates/templartorrent-core/src/budget.rs",
        "integration/**"
    ]
    verified_by [
        @templartorrent.evidence.complete-piece-integration-checks/1,
        @templartorrent.evidence.complete-piece-metrics/1,
        @templartorrent.evidence.complete-piece-root/1,
        @templartorrent.evidence.complete-piece-wire/1
    ]
}


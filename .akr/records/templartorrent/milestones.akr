            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost file_backed_resume"
            verified_by [ @templartorrent.evidence.rbit-driver-path/1 ]
        }
        check file-transfer {
            statement """
                Headless localhost v1 transfer into a fresh temp dir completes with on-disk bytes equal to the owned fixture
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost file_backed_transfer"
            verified_by [ @templartorrent.evidence.rbit-driver-path/1 ]
        }
        check live-commands {
            statement """
                UI dispatches typed commands with reliable acks against a live session
                """
            method command
            command "cargo test --manifest-path integration/pixelkit-preview/Cargo.toml live_commands"
            verified_by [ @templartorrent.evidence.preview-live-commands/1 ]
        }
        check no-fixture-live {
            statement """
                Live mode renders engine snapshots only; fixture rows confined to the preview harness
                """
            method observation
            verified_by [ @templartorrent.evidence.no-fixture-live/1 ]
        }
    }
}

record templartorrent.milestone.native-source-gate/1 : milestone {
    title "Close the strict native-source audit for the default build"
    state completed
    scope [
        path "Cargo.toml",
        path "docs/DEPENDENCY-AUDIT.md",
        path "integration/rbit-adapter/**",
        path "vendor/rbit/**"
    ]
    intent """
        Remove ring, rustls and reqwest from the workspace dependency graph by forking rbit 0.2.2 in-tree with reqwest optional, announce to HTTP trackers over an application-owned bounded transport, refuse https trackers with a visible reason, and document the remaining accepted boundary (OS bindings such as libc, wayland-sys, drm-sys, linux-raw-sys and pure-Rust build scripts).
        """
    note """
        Opened 2026-10-22 after the owner chose the fork option for question ring-release-gate. HTTPS tracker support stays open as a separate, explicitly visible limitation.
        """
    acceptance {
        check announce-transport {
            statement """
                Adapter tests show the application-owned announce building a correct GET with the passkey query preserved and binary fields percent-encoded, accepting 200 responses with content length or chunked encoding, refusing redirects, non-200, truncation and oversize, parsing compact and dictionary peers, refusing https with a visible reason, and the existing loopback tracker fixtures still discovering peers end to end.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter"
            verified_by [ @templartorrent.evidence.announce-transport/1 ]
        }
        check gates {
            statement """
                Workspace tests, formatting, Clippy with warnings denied and the release build pass against the forked rbit.
                """
            method command
            command "cargo test --workspace --all-targets && cargo clippy --workspace --all-targets -- -D warnings && cargo build --release -p templartorrent"
            verified_by [ @templartorrent.evidence.fork-gates/1 ]
        }
        check ring-absent {
            statement """
                cargo tree on the workspace graph finds no package named ring, rustls or reqwest, and the only -sys crates are OS bindings.
                """
            method command
            command "cargo tree --workspace --offline -i ring"
            verified_by [ @templartorrent.evidence.native-audit-after-fork/1 ]
        }
    }
    after [ @templartorrent.milestone.picker-optimization ]
    derived_from [ @templartorrent.decision.fork-rbit-for-native-gate ]
}

record templartorrent.milestone.parser-fuzzing/1 : milestone {
    title "Bounded parser and engine fuzzing with every found crash fixed and pinned"
    state completed
    scope [
        path "fuzz/**",
        path "integration/rbit-adapter/**",
        path "integration/templartorrent/src/persist.rs",
        path "vendor/rbit/src/**"
    ]
    intent """
        DESIGN.md section 10 requires bounded parser fuzzing. Add libFuzzer targets, in their own workspace outside the shipping graph, for every parser that remote or on-disk bytes reach (tracker HTTP and announce body, metainfo and the BEP-9 info envelope, magnet and tracker URL, peer wire and extension messages, bencode, persisted session records) plus a stateful engine-session target under adversarial peer behaviour. Fix every crash at its source, including in the rbit fork, and pin each with a stable-toolchain regression test that fails before the fix.
        """
    acceptance {
        check bounded-run-clean {
            statement """
                fuzz/run.sh replays every saved regression input and then runs every target for 600 s with no crash, leak or timeout
                """
            method command
            command "fuzz/run.sh 600"
            verified_by [ @templartorrent.evidence.fuzz-bounded-run/1 ]
        }
        check crashes-pinned {
            statement """
                Each crash the fuzzers found has a stable-toolchain regression test that fails with the fix reverted and passes with it
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test parser_regressions && cargo test -p templartorrent --lib hex_fields"
            verified_by [ @templartorrent.evidence.fuzz-regressions-pinned/1 ]
        }
        check gates {
            statement """
                Formatting, all-target Clippy with warnings denied, the workspace tests and the release build pass with the fixes
                """
            method command
            command "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace --all-targets && cargo build --release"
            verified_by [ @templartorrent.evidence.fuzz-and-throughput-gates/1 ]
        }
        check targets-build {
            statement """
                cargo +nightly fuzz build builds all seven targets, and libfuzzer-sys is absent from the root workspace graph
                """
            method command
            command "cargo +nightly fuzz build && cargo tree --workspace -i libfuzzer-sys"
            verified_by [ @templartorrent.evidence.fuzz-targets-build/1 ]
        }
    }
}

record templartorrent.milestone.performance-baselines/1 : milestone {
    title "Performance baselines recorded before any optimization"
    state completed
    scope [
        path "crates/templartorrent-bench/**",
        path "crates/templartorrent-core/src/sequence.rs",
        path "crates/templartorrent-simd/**",
        path "integration/rbit-adapter/tests/driver.rs"
    ]
    intent """
        AGENTS.md step 5, first half: establish repeatable baselines on the documented development laptop per docs/PERFORMANCE.md before optimizing anything. Record the microbenchmark at 1k, 100k and 1M pieces with scalar and runtime-dispatched AVX2 backends, a release-profile localhost magnet-to-first-verified-piece sample with payload high-water and sampled RSS, and the scalar/AVX2 equivalence tests, as raw JSONL and logs under perf-results/. Name the measured hot spot that any later optimization must target with before/after evidence.
        """
    note """
        Opened 2026-10-22 after persistence completed. Optimization itself is deliberately a later work item: PERFORMANCE.md requires repeated whole-scenario improvement with before/after evidence, and this milestone only establishes the before.
        """
    acceptance {
        check magnet-startup-sample {
            statement """
                A release-profile localhost magnet-to-first-verified-piece sample records metadata, first verified write and total transfer nanoseconds with payload high-water and sampled RSS, labelled as including fixture and seeder.
                """
            method command
            command "cargo test --release -p templartorrent-rbit-adapter --test driver -- driver_magnet_to_first_verified_metrics --nocapture"
            verified_by [ @templartorrent.evidence.baseline-magnet-startup/1 ]
        }
        check microbench-matrix {
            statement """
                Release microbenchmark JSONL exists for 1k, 100k and 1M pieces on the documented CPU with the detected backend named, including a repeat run at one size to show run-to-run spread.
                """
            method command
            command "cargo run --release -p templartorrent-bench -- --pieces 100000 --iterations 500"
            verified_by [ @templartorrent.evidence.baseline-microbench/1 ]
        }
        check scalar-avx2-equivalence {
            statement """
                SIMD equivalence tests pass showing scalar and AVX2 eligibility outputs match at every length including zero, unaligned sub-slices and non-multiples of four words.
                """
            method command
            command "cargo test -p templartorrent-simd"
            verified_by [ @templartorrent.evidence.baseline-simd-equivalence/1 ]
        }
    }
    after [ @templartorrent.milestone.session-persistence ]
}

record templartorrent.milestone.picker-optimization/1 : milestone {
    title "Optimize the measured hot spot: O(P) piece selection"
    state completed
    scope [
        path "crates/templartorrent-bench/**",
        path "crates/templartorrent-core/src/sequence.rs",
        path "crates/templartorrent-engine/**",
        path "crates/templartorrent-simd/**"
    ]
    intent """
        AGENTS.md step 5, second half, driven by the 2026-10-22 baseline: the reference piece pick scans every piece per call (about 3 us at 1k pieces, 170 to 350 us at 100k, 4.8 ms at 1M on the documented laptop) while the AVX2 eligibility kernel shows no consistent gain over scalar. Replace the per-pick full scan with per-rank availability buckets or dirty candidate windows in the live engine, keep the dependency-free scalar Sequence as the oracle, and prove equal picks against it on randomized fixtures plus repeated before/after microbench and one whole-scenario localhost measurement. Do not integrate the AVX2 kernel into the picker unless the same evidence shows a win.
        """
    note """
        Proposed 2026-10-22; not started. PERFORMANCE.md optimization acceptance applies: no correctness, privacy or safety regression, repeated whole-scenario improvement, oracle and boundary tests re-run after the change.
        """
    acceptance {
        check microbench-before-after {
            statement """
                Repeated release microbench runs at 1k, 100k and 1M pieces show the pick cost reduced against the 2026-10-22 baseline with the spread of both reported.
                """
            method command
            command "cargo run --release -p templartorrent-bench -- --pieces 100000 --iterations 500"
            verified_by [ @templartorrent.evidence.picker-microbench/1 ]
        }
        check oracle-equivalence {
            statement """
                Randomized tests show the optimized picker returns the same piece as the scalar Sequence oracle for every peer bitfield, rank layout and reservation state tried, including boundary pieces and more than 255 ranked files.
                """
            method command
            command "cargo test --workspace"
            verified_by [ @templartorrent.evidence.picker-oracle-equivalence/1 ]
        }
        check scenario-before-after {
            statement """
                A release localhost transfer with a large piece count shows no regression in magnet-to-first-verified time, payload high-water or RSS against the baseline sample, repeated at least three times.
                """
            method command
            command "cargo test --release -p templartorrent-rbit-adapter --test driver -- driver_magnet_to_first_verified_metrics --nocapture"
            verified_by [ @templartorrent.evidence.picker-scenario-and-gates/1 ]
        }
    }
    after [ @templartorrent.milestone.performance-baselines ]
}

record templartorrent.milestone.public-swarm-client/1 : milestone {
    title "Public-swarm client: verified Ubuntu ISO download from the Internet with UDP trackers, dual-stack, DHT, PEX and MSE"
    state completed
    scope [
        path "crates/**",
        path "fuzz/**",
        path "integration/rbit-adapter/**",
        path "integration/templartorrent/**",
        path "vendor/rbit/**"
    ]
    intent """
        Close the gaps that kept the client from replacing Deluge or Transmission on public torrents: per-family (BEP 7) HTTP and UDP (BEP 15) announces, a fixed dual-stack listen port, .torrent files added from their own info dictionary instead of BEP-9, non-blocking peer connects, DHT (BEP 5), PEX (BEP 11), MSE/PE encryption with plaintext fallback, an own peer-ID prefix, more than 128 files, and hybrid torrents through the v1 path with BEP 47 pad files. Pure v2 stays refused with a visible reason. The user permitted an opt-in Internet smoke test with ubuntu-26.04.1-desktop-amd64.iso.torrent on 2026-10-25.
        """
    note """
        Baseline on 2026-10-25: adding the Ubuntu .torrent failed in 3.9 s with 'no permitted peer supplied valid metadata'. Announces went over IPv4 only and the tracker returned 1 peer, against 25 (24 IPv6) over IPv6.
        """
    acceptance {
        check dht-pex {
            statement """
                PEX added peers reach a public job's pool in a loopback two-driver test and are never offered or accepted for private jobs; DHT get_peers supplies candidates to a public job on the Internet run
                """
            method command
            verified_by [ @templartorrent.evidence.pex-loopback-and-dht-internet/1 ]
        }
        check formats {
            statement """
                Torrents with more than 128 files and hybrid torrents with pad files download and verify in loopback tests; pure v2 is refused with a visible reason
                """
            method command
            verified_by [ @templartorrent.evidence.formats-hybrid-many-files/1 ]
        }
        check gates {
            statement """
                Formatting, all-target Clippy with warnings denied, workspace tests, fuzz targets and the release build pass; ring is still not built
                """
            method command
            verified_by [ @templartorrent.evidence.public-swarm-gates/1 ]
        }
        check internet-ubuntu {
            statement """
                The opt-in smoke test downloads the permitted Ubuntu 26.04.1 desktop ISO to completion from the public swarm, every piece hash-verified, with peers, rates and RSS recorded and no peer addresses or info hash in the log
                """
            method command
            command "TT_INTERNET_TORRENT=~/Downloads/ubuntu-26.04.1-desktop-amd64.iso.torrent TT_INTERNET_DEST=<new dir> cargo test --release -p templartorrent-rbit-adapter --test internet_smoke -- --ignored --nocapture"
            verified_by [ @templartorrent.evidence.internet-ubuntu-download/1 ]
        }
        check mse {
            statement """
                MSE/PE outgoing and incoming handshakes interoperate in loopback tests, with plaintext fallback and per-job routing of encrypted incoming connections, and negotiate with real peers
                """
            method command
            verified_by [ @templartorrent.evidence.mse-tests-and-real-peers/1 ]
        }
        check udp-and-family-announce {
            statement """
                UDP tracker announces (BEP 15) and per-address-family announces pass loopback fixture tests including timeouts, connection-id expiry and malformed replies
                """
            method command
            verified_by [ @templartorrent.evidence.udp-family-announce-tests/1 ]
        }
    }
}

record templartorrent.milestone.reachability/1 : milestone {
    title "Be findable and reachable: DHT announce_peer, opt-in router port mapping, IPv6 peer path"
    state completed
    scope [
        path "fuzz/**",
        path "integration/rbit-adapter/**",
        path "integration/templartorrent/**",
        path "vendor/rbit/src/dht/**"
    ]
    intent """
        After the public-swarm milestone, close the three reachability gaps the user asked for on 2026-10-26: announce our listen port to the DHT; map it on the router with NAT-PMP or UPnP IGD, opt-in and restricted to the default gateway (DESIGN.md section 9); and exercise the IPv6 peer path, here over loopback because the hotel network has no IPv6.
        """
    note """
        The user attributed the run-2 stall to hotel Wi-Fi; observation internet-download-stall was revised accordingly.
        """
    acceptance {
        check dht-announce {
            statement """
                A loopback DHT node finds a port another node announced, and real DHT nodes accept the client's announces on the Internet run
                """
            method command
            verified_by [ @templartorrent.evidence.dht-announce/1 ]
        }
        check gates {
            statement """
                Formatting, Clippy with warnings denied, workspace tests, fuzz build and the native audit pass
                """
            method command
            verified_by [ @templartorrent.evidence.reachability-gates/1 ]
        }
        check ipv6-path {
            statement """
                Payload moves over ::1 outgoing and through a dual-stack [::] listener to IPv6 and IPv4 leeches
                """
            method command
            verified_by [ @templartorrent.evidence.ipv6-loopback-path/1 ]
        }
        check port-mapping {
            statement """
                NAT-PMP and UPnP IGD mapping passes loopback fixture tests including spoofed replies, renewal, removal on shutdown and refused foreign LOCATIONs; the setting defaults to off; the parsers fuzz clean; a read-only probe of the real gateway creates no mapping
                """
            method command
            verified_by [ @templartorrent.evidence.port-mapping/1 ]
        }
    }
}

record templartorrent.milestone.safety-and-peer-policy/1 : milestone {
    title "Protected storage, crash/private-discovery tests, capability gates and peer preference"
    state completed
    scope [
        path "crates/templartorrent-engine/**",
        path "crates/templartorrent-storage/**",
        path "integration/rbit-adapter/**",
        path "integration/templartorrent/**"
    ]
    intent """
        AGENTS.md step 4 on the Linux production client: protected handle-relative storage and deletion with explicit refusals, resume and forced-crash restart tests, private-discovery scope tests, v2/hybrid capability gates that reject with a visible reason, and offline country/client/peer-preference integration (Prefer/Normal/Avoid/Block applied locally by the Driver and exposed in the Peers tab).
        """
    note """
        Opened 2026-10-22 after milestones for AGENTS steps 2 and 3 completed. Peer preference is local only: it orders upload slots, narrows or keeps request pipelines, decides retention when caps shrink, and Block closes and refuses the peer's IP for that job. It is not automatic peer scoring.
        """
    acceptance {
        check capability-gates {
            statement """
                v2 and hybrid magnets and torrent files are rejected with a clear message before any payload storage is created; private metadata revokes public bootstrap.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter"
            verified_by [ @templartorrent.evidence.step4-capability-gates/1 ]
        }
        check forced-crash-restart {
            statement """
                A job whose process is killed mid-transfer restarts from disk with a recheck, requests only missing pieces, and completes with bytes equal to the fixture.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.step4-forced-crash-restart/1 ]
        }
        check offline-country-client {
            statement """
                Peer country resolves only from a local MMDB and shows -- without one; client names come from the sanitized extension handshake with Unknown fallback; no network lookup exists.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.step4-offline-country-client/1 ]
        }
        check peer-preference-driver {
            statement """
                Adapter tests show Block closing the matching peer and refusing its reconnection and new candidates, Avoid narrowing that peer's request pipeline, Prefer being retained ahead of Normal and Avoid when connection caps shrink, and upload slots ordered Prefer before Normal before Avoid.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.peer-preference-driver/1 ]
        }
        check peer-preference-ui {
            statement """
                The production client's worker routes SetPeerPreference to the Driver with a real acknowledgement, peer rows carry the preference, and headless tests pass.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.peer-preference-client/1 ]
        }
        check protected-deletion {
            statement """
                Storage and Driver tests show handle-relative no-follow deletion refusing symlinks, hardlinks and identity changes, never removing the destination root, and removal without deletion retaining data.
                """
            method command
            command "cargo test -p templartorrent-storage && cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.step4-protected-deletion/1 ]
        }
    }
    after [ @templartorrent.milestone.native-app-wiring ]
}

record templartorrent.milestone.session-persistence/1 : milestone {
    title "Session persistence: jobs, settings and preferences survive a restart"
    state completed
    scope [ path "integration/rbit-adapter/**", path "integration/templartorrent/**" ]
    intent """
        DESIGN.md sections 1 and 7: the Linux client saves schema-versioned per-job records (original torrent bytes, destination, running or paused intent, file selection and order, tracker URLs, peer preferences) and global settings under the XDG data directory with atomic temp-file-and-rename writes, and on the next launch restores every job through a disk recheck off the UI thread without contacting any peer or tracker that the job did not already know. Removal deletes the record. A corrupt or oversized record is skipped with a visible reason, never a panic.
        """
    note """
        Opened 2026-10-22 after the step 4 milestone completed. No resume bitmap is persisted yet: every launch rechecks from disk, which is the conservative choice DESIGN.md permits. Restoring a job does not re-resolve metadata over the network because the torrent bytes are kept.
        """
    acceptance {
        check client-roundtrip {
            statement """
                Production client tests show a record encoding and decoding to equal values, atomic writes leaving either the old or the new file, oversized or malformed records rejected with a reason, and the worker restoring saved jobs and settings on start and deleting the record on remove.
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.persistence-client/1 ]
        }
        check driver-restore {
            statement """
                An adapter test exports a job record from one Driver, restores it into a fresh Driver from the stored torrent bytes with ExistingData::Recheck and no peer, and observes the same destination, name, file selection, file order and peer preferences, with verified bytes adopted from disk and completion once a tracker or peer is reachable.
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test driver"
            verified_by [ @templartorrent.evidence.persistence-driver/1 ]
        }
        check gates {
            statement """
                Formatting and all-target Clippy with warnings denied pass in the root workspace.
                """
            method command
            command "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
            verified_by [ @templartorrent.evidence.persistence-gates/1 ]
        }
    }
    after [ @templartorrent.milestone.safety-and-peer-policy ]
}

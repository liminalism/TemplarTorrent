akr 0.1
project templartorrent

record templartorrent.milestone.http-downloads/1 : milestone {
    title "HTTP(S) file downloads in the same queue, proven on localhost fixtures"
    state completed
    scope [
        path "crates/templartorrent-core/**",
        path "crates/templartorrent-engine/**",
        path "crates/templartorrent-storage/**",
        path "integration/**"
    ]
    intent """
        Implement decision http-download-manager: URL jobs in the existing queue and Add dialog (one URL or a bounded batch, the folder browser, pause, resume, retry, cancel, the remove dialog with the data checkbox defaulting to keeping files), on the rustls transport with name checks, a redirect cap and address admission behind --allow-local-urls; ranged parallel parts reserved from the global payload budget and the shared download rate; resume only under a matching ETag or Last-Modified; a 30 s no-data cut per connection; temporary sibling, fsync, rename; em dash for unknown sizes; optional SHA-256 before completion; persistence through the session store with restore on launch. Torrent behaviour keeps working.
        """
    acceptance {
        check client-wiring {
            statement """
                The worker accepts AddUrl, Pause, Resume, Retry, Cancel and Remove for URL jobs, merges them into the snapshot, saves .url records and restores them on launch; headless UI tests still pass
                """
            method command
            command "cargo test -p templartorrent"
            verified_by [ @templartorrent.evidence.http-client-wiring/1 ]
        }
        check crash-resume {
            statement """
                A job restored from a persisted record after an abrupt stop continues from offsets that never exceed the synced bytes and completes with matching bytes
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download crash"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check gates {
            statement """
                Formatting, all-target Clippy with warnings denied and the workspace test suite pass; unit, packet, privacy and storage tests ran after the transport change
                """
            method command
            command "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace --all-targets --no-fail-fast"
            verified_by [ @templartorrent.evidence.http-gates/1 ]
        }
        check identity-mismatch {
            statement """
                A resume whose ETag or Last-Modified no longer matches stops the job with a visible reason and keeps the partial file; a matching validator resumes from the persisted offset
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download identity"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check pause-resume {
            statement """
                Pause stops every connection and keeps the partial file; Resume continues from the recorded offsets and the final file matches the fixture
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download pause"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check ranged-and-plain-bodies {
            statement """
                A localhost server with Accept-Ranges yields a parallel multi-part download whose output matches the fixture bytes, and a server without ranges yields a single-connection download, including a chunked body of unknown size shown as an em dash
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download ranged plain"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check redirect-bound {
            statement """
                Up to 5 redirects are followed with each hop re-admitted; a sixth is refused with a visible reason, as are a redirect to a private address and an https-to-http downgrade
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download redirect"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check safe-deletion {
            statement """
                Remove with data deletes the final file and the temporary sibling through the no-follow path, refuses a symlink or a swapped inode, and never removes the destination folder
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download delete"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
        check shared-speed-limit {
            statement """
                With the session download limit set, a URL download spends from the same token bucket as peers and takes at least the time the limit implies, and its read buffers show in the global payload budget
                """
            method command
            command "cargo test -p templartorrent-rbit-adapter --test http_download limit"
            verified_by [ @templartorrent.evidence.http-fixtures/1 ]
        }
    }
    after [ @templartorrent.milestone.reachability ]
    author "Claude"
}

record templartorrent.milestone.local-v1-transfer/1 : milestone {
    title "Deterministic localhost v1 transfer and seed"
    state completed
    scope [ path "crates/**", path "integration/rbit-adapter/**" ]
    intent """
        AGENTS.md step 2 / INTEGRATION.md B-C: headless templartorrent-engine does a deterministic localhost v1 transfer and seed with real rbit networking, verified data, bounded memory, and fault injection.
        """
    acceptance {
        check bounded-memory {
            statement """
                No unbounded task/queue growth: one lease coordinator, one session arbiter, bounded disk/hash workers, lease + memory admission before receive_block
                """
            method observation
            verified_by [ @templartorrent.evidence.localhost-bounded-memory/1 ]
        }
        check fault-injection {
            statement """
                Injected peer drops and corrupt blocks yield recoverable errors, never panic or silent completion
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost fault_injection"
            verified_by [ @templartorrent.evidence.localhost-faults/1 ]
        }
        check localhost-transfer {
            statement """
                Headless localhost v1 transfer completes: explicit src/dst, injected 127.0.0.1 tracker/peer route, final bytes equal owned fixture
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost localhost_transfer"
            verified_by [ @templartorrent.evidence.localhost-transfer/1 ]
        }
        check metadata-exchange {
            statement """
                Leecher starting from infohash alone fetches metainfo via BEP-9, verifies raw infohash, then transfers
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost metadata_exchange"
            verified_by [ @templartorrent.evidence.localhost-metadata/1 ]
        }
        check real-networking {
            statement """
                Transfer uses real rbit networking only; no fixture backend stands in for the wire
                """
            method observation
            verified_by [ @templartorrent.evidence.localhost-real-networking/1 ]
        }
        check seam-audit {
            statement """
                Rbit seam audit per INTEGRATION.md C evidenced: framing cancellation, directional ext IDs, bounded announce, blame handling
                """
            method observation
            verified_by [ @templartorrent.evidence.localhost-seam-audit/1 ]
        }
        check seed-path {
            statement """
                Completed leecher seeds verified bytes to a third peer
                """
            method command
            command "cargo test --manifest-path integration/rbit-adapter/Cargo.toml --test localhost seed_serves_verified_bytes"
            verified_by [ @templartorrent.evidence.localhost-seed/1 ]
        }
    }
}

record templartorrent.milestone.loopback-throughput/1 : milestone {
    title "Remove the two measured transfer stalls: per-piece fdatasync and Nagle on peer streams"
    state completed
    scope [
        path "crates/templartorrent-storage/src/lib.rs",
        path "integration/rbit-adapter/src/driver.rs",
        path "vendor/rbit/src/peer/transport.rs"
    ]
    intent """
        AGENTS.md step 5: optimize from evidence. The 32 MiB loopback scenario ran at about 6 MB/s on tmpfs and 1.5 to 2.2 MB/s on a real btrfs disk. Two causes, each measured alone: FileStore synced every 16 KiB piece although the resume checkpoint's sync_all is the only barrier the bitmap needs (DESIGN.md: persist batched changes, sync before marking resume bits durable), and no peer stream set TCP_NODELAY, so each pipelined Request waited for a delayed ACK. Fix both without weakening the resume guarantee and record before/after with attribution.
        """
    note """
        Fixture seeders share rbit's transport, so they also gained nodelay; a client-only variant was measured separately.
        """
    acceptance {
        check before-after {
            statement """
                Three release runs each of the 2048-piece and 4-piece loopback scenarios before and after, on tmpfs and on btrfs, with each change also measured alone
                """
            method command
            command "perf-results/2026-10-24-write-path/large-scenario.sh <log>, with TMPDIR on btrfs for the disk runs"
            verified_by [ @templartorrent.evidence.write-path-before-after/1 ]
        }
        check gates {
            statement """
                Formatting, all-target Clippy with warnings denied and the release build pass; ring is still not built
                """
            method command
            command "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo build --release && cargo tree --workspace -i ring"
            verified_by [ @templartorrent.evidence.fuzz-and-throughput-gates/1 ]
        }
        check resume-safety {
            statement """
                Resume, forced-crash restart, storage and deletion tests pass on tmpfs and with TMPDIR on btrfs; the resume checkpoint still reads the verified set before sync_all
                """
            method command
            command "cargo test --workspace --all-targets --no-fail-fast (twice on tmpfs, once with TMPDIR on btrfs)"
            verified_by [ @templartorrent.evidence.write-path-safety-tests/1 ]
        }
    }
}

record templartorrent.milestone.native-app-wiring/1 : milestone {
    title "File-backed transfers and live UI wiring"
    state completed
    scope [ path "crates/**", path "integration/**" ]
    intent """
        AGENTS.md step 3: file-backed headless transfers on real directories (validated paths, no silent overwrite, disk resume without rewrite) plus PixelKit live wiring (typed commands/acks, add/limits/remove dialogs), no fixture data in live mode.
        """
